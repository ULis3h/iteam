generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A machine that executes agents. The server itself is the implicit "local" runner;
// remote machines connect with the runner CLI and appear here.
model Runner {
  id           String   @id @default(uuid())
  name         String   @unique
  hostname     String   @default("")
  os           String   @default("")
  arch         String   @default("")
  version      String   @default("")
  status       String   @default("offline") // online | offline
  capabilities String   @default("[]")      // JSON string[]: providers available on that machine
  lastSeen     DateTime @default(now())
  createdAt    DateTime @default(now())

  agents Agent[]

  @@map("runners")
}

// An agent = a role + a CLI runtime (provider/model/effort) + where it runs (local or a runner).
model Agent {
  id          String   @id @default(uuid())
  name        String   @unique
  description String   @default("")
  role        String   @default("")            // persona / instructions prepended to every prompt
  location    String   @default("local")       // local | remote
  runnerId    String?
  provider    String   @default("claude-code") // claude-code | codex | gemini | custom
  model       String   @default("")
  effort      String   @default("medium")      // low | medium | high | max
  workDir     String   @default("")
  command     String   @default("")            // custom provider: command template
  extraArgs   String   @default("[]")          // JSON string[]
  env         String   @default("{}")          // JSON Record<string,string>
  autoApprove Boolean  @default(true)
  timeoutSec  Int      @default(1800)
  color       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  runner   Runner?   @relation(fields: [runnerId], references: [id], onDelete: SetNull)
  runSteps RunStep[]

  @@map("agents")
}

// A reusable pipeline definition: inputs + steps (DAG) assigned to agents.
model Workflow {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  inputs      String   @default("[]") // JSON WorkflowInput[]
  steps       String   @default("[]") // JSON WorkflowStep[]
  source      String   @default("ui") // ui | import
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  runs Run[]

  @@map("workflows")
}

// One execution of a workflow (or a quick single-step task).
model Run {
  id         String    @id @default(uuid())
  workflowId String?
  name       String
  status     String    @default("queued") // queued | running | succeeded | failed | cancelled
  inputs     String    @default("{}")     // JSON Record<string,string>
  snapshot   String    @default("{}")     // JSON: workflow definition frozen at run time
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  workflow Workflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  steps    RunStep[]

  @@index([status])
  @@index([createdAt])
  @@map("runs")
}

model RunStep {
  id              String    @id @default(uuid())
  runId           String
  key             String    // step id inside the workflow
  name            String
  order           Int
  agentId         String?
  agentName       String
  dependsOn       String    @default("[]") // JSON string[]
  status          String    @default("pending") // pending | running | succeeded | failed | skipped | cancelled
  attempt         Int       @default(0)
  maxAttempts     Int       @default(1)
  continueOnError Boolean   @default(false)
  prompt          String?
  output          String?
  error           String?
  exitCode        Int?
  provider        String    @default("")
  model           String    @default("")
  effort          String    @default("")
  location        String    @default("local")
  runnerId        String?
  startedAt       DateTime?
  finishedAt      DateTime?

  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)
  agent Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  logs  RunLog[]

  @@unique([runId, key])
  @@map("run_steps")
}

model RunLog {
  id     Int      @id @default(autoincrement())
  stepId String
  seq    Int
  ts     DateTime @default(now())
  stream String   // stdout | stderr | system
  line   String

  step RunStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId, seq])
  @@map("run_logs")
}
