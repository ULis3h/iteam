# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="file:./dev.db"

# CORS
CORS_ORIGIN=http://localhost:5173

# WebSocket
WS_PING_INTERVAL=30000
WS_PING_TIMEOUT=5000

# ============================================================================
# mem0 Memory Service Configuration
# ============================================================================
# MEM0_MODE: 'cloud' | 'local' | 'fallback' (default: fallback)
#   - cloud:    使用 mem0 Platform API (需要 MEM0_API_KEY)
#   - local:    使用 mem0 OSS + Ollama 本地运行 (需要 Ollama 服务)
#   - fallback: 自动检测 - 有 API Key 用 cloud，有 Ollama 用 local，否则仅 Prisma
MEM0_MODE=fallback

# --- Cloud 模式配置 ---
# MEM0_API_KEY=your-mem0-api-key-here

# --- Local 模式配置 ---
# MEM0_OLLAMA_URL=http://localhost:11434
# MEM0_LLM_MODEL=llama3.1:latest
# MEM0_EMBED_MODEL=nomic-embed-text:latest
# MEM0_VECTOR_PROVIDER=memory
# MEM0_VECTOR_DB_PATH=./data/mem0-vectors.db
# MEM0_HISTORY_DB_PATH=./data/mem0-history.db

# --- Qdrant 向量数据库 (可选，替代内置 SQLite) ---
# MEM0_VECTOR_PROVIDER=qdrant
# MEM0_QDRANT_HOST=localhost
# MEM0_QDRANT_PORT=6333
# MEM0_QDRANT_COLLECTION=iteam_memories
# MEM0_EMBED_DIMS=768
