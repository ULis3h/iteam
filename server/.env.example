# 服务端口 / Server port
PORT=3000

# 访问令牌（留空 = 本机开放访问）。设置后 Web 界面和 Runner 都需要携带该令牌。
# Access token (empty = open access on localhost). When set, both the web UI and runners must present it.
ITEAM_TOKEN=

# SQLite 数据库位置（相对于 server/prisma）/ SQLite location (relative to server/prisma)
DATABASE_URL="file:./iteam.db"

# 同时执行的最大步骤数 / Max steps executed concurrently
ITEAM_MAX_PARALLEL=4

# 本地 Agent 的默认工作目录 / Default working directory for local agents
ITEAM_WORK_DIR=
