# 服务端口 / Server port (the Vite dev proxy reads this file too)
PORT=3000

# 监听地址 / Bind address.
# 默认：设置了 ITEAM_TOKEN 时监听 0.0.0.0，否则只监听 127.0.0.1（本机）。
# Default: 0.0.0.0 when ITEAM_TOKEN is set, otherwise 127.0.0.1 (this machine only).
HOST=

# 访问令牌 / Access token. 设置后 Web 界面必须输入该令牌；未设置时 API 只对本机开放。
# When set, the web UI asks for it; when empty the API is only reachable from this machine.
ITEAM_TOKEN=

# Runner 专用令牌（可选，默认与 ITEAM_TOKEN 相同）。给远程机器一个不能操作 API 的独立凭证。
# Optional separate credential for runners (defaults to ITEAM_TOKEN).
ITEAM_RUNNER_TOKEN=

# 允许跨域调用 API 的浏览器来源（逗号分隔）。内置界面同源，无需设置。
# Extra browser origins allowed to call the API (comma separated). The bundled UI needs none.
ITEAM_CORS_ORIGINS=

# SQLite 数据库位置（相对于 server/prisma）/ SQLite location (relative to server/prisma)
DATABASE_URL="file:./iteam.db"

# 同时执行的最大步骤数 / Max steps executed concurrently
ITEAM_MAX_PARALLEL=4

# 本地 Agent 的默认工作目录（默认：用户主目录）/ Default working directory for local agents (default: home directory)
ITEAM_WORK_DIR=

# 已完成运行的保留天数，0 = 永久保留 / Days to keep finished runs, 0 = forever
ITEAM_RETENTION_DAYS=0
