{
  "name": "iteam-vscode",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "iteam",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "iteam.connect",
        "title": "%cmd.connect%",
        "category": "iTeam"
      },
      {
        "command": "iteam.disconnect",
        "title": "%cmd.disconnect%",
        "category": "iTeam"
      },
      {
        "command": "iteam.setRole",
        "title": "%cmd.setRole%",
        "category": "iTeam"
      },
      {
        "command": "iteam.setSkills",
        "title": "%cmd.setSkills%",
        "category": "iTeam"
      },
      {
        "command": "iteam.executeTask",
        "title": "%cmd.executeTask%",
        "category": "iTeam"
      },
      {
        "command": "iteam.showDeviceInfo",
        "title": "%cmd.showDeviceInfo%",
        "category": "iTeam"
      },
      {
        "command": "iteam.showLogs",
        "title": "%cmd.showLogs%",
        "category": "iTeam"
      },
      {
        "command": "iteam.openDashboard",
        "title": "%cmd.openDashboard%",
        "category": "iTeam"
      },
      {
        "command": "iteam.switchLanguage",
        "title": "%cmd.switchLanguage%",
        "category": "iTeam"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "iteam.serverUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "%config.serverUrl%"
        },
        "iteam.apiKey": {
          "type": "string",
          "default": "",
          "description": "%config.apiKey%"
        },
        "iteam.deviceName": {
          "type": "string",
          "default": "",
          "description": "%config.deviceName%"
        },
        "iteam.role": {
          "type": "string",
          "enum": [
            "frontend",
            "backend",
            "fullstack",
            "devops",
            "qa",
            "architect",
            "pm",
            "designer"
          ],
          "default": "fullstack",
          "description": "%config.role%"
        },
        "iteam.skills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "typescript"
          ],
          "description": "%config.skills%"
        },
        "iteam.aiProvider": {
          "type": "string",
          "enum": [
            "anthropic",
            "openai",
            "custom"
          ],
          "default": "anthropic",
          "description": "%config.aiProvider%"
        },
        "iteam.aiModel": {
          "type": "string",
          "default": "claude-sonnet-4-5",
          "description": "%config.aiModel%"
        },
        "iteam.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoConnect%"
        },
        "iteam.heartbeatInterval": {
          "type": "number",
          "default": 30000,
          "minimum": 5000,
          "maximum": 120000,
          "description": "%config.heartbeatInterval%"
        },
        "iteam.anthropicApiKey": {
          "type": "string",
          "default": "",
          "description": "%config.anthropicApiKey%"
        },
        "iteam.taskExecution.mode": {
          "type": "string",
          "enum": [
            "api",
            "ide",
            "terminal",
            "background",
            "manual"
          ],
          "default": "ide",
          "description": "%config.taskExecutionMode%"
        },
        "iteam.taskExecution.autoAccept": {
          "type": "boolean",
          "default": true,
          "description": "%config.taskAutoAccept%"
        },
        "iteam.language": {
          "type": "string",
          "enum": [
            "en",
            "zh-CN"
          ],
          "default": "en",
          "description": "%config.language%",
          "enumDescriptions": [
            "English",
            "中文（简体）"
          ]
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "iteam-container",
          "title": "%view.container.title%",
          "icon": "resources/icons/iteam-logo.svg"
        }
      ]
    },
    "views": {
      "iteam-container": [
        {
          "type": "webview",
          "id": "iteam-sidebar",
          "name": "%view.sidebar.name%"
        },
        {
          "id": "iteam-tasks",
          "name": "%view.tasks.name%"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "watch": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "lint": "eslint src --ext ts"
  },
  "dependencies": {
    "socket.io-client": "^4.5.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "esbuild": "^0.19.0"
  }
}